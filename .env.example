# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible chat completions API).
# Confirm the exact base URL and model IDs in your Token Factory console.
TOKEN_FACTORY_BASE_URL=
TOKEN_FACTORY_API_KEY=

# Model IDs as listed in the console (Ultra for plan/generate, Nano for cheap calls).
SIMSMITH_MODEL_PLAN=
SIMSMITH_MODEL_GENERATE=
SIMSMITH_MODEL_FAST=

# Command that runs a Python script inside Isaac Sim headless, e.g. the
# python.sh shipped with your pinned Isaac Sim install. Leave empty to use
# the local python (only useful for mock scripts and tests).
SIMSMITH_SIM_PYTHON=

# Per-run limits
SIMSMITH_RUN_TIMEOUT_S=180
SIMSMITH_SEEDS=3

# LLM cost controls. Price per 1M tokens, looked up per-model by matching the model
# id against "ultra"/"super"/"nano" as a case-insensitive substring (see
# _price_for_model() in simsmith/llm.py) -- set the pair for whichever tier(s) you
# actually use. SIMSMITH_PRICE_IN/OUT below is the flat fallback for any model that
# doesn't match one of those three (also what the test suite uses). A model with no
# price configured at all (neither a tier match nor the flat fallback) reports
# cost_usd as unknown, never a fake $0 -- so a budget cap only protects spend on
# models you've actually priced here.
# Leave SIMSMITH_BUDGET_USD empty for no cap; set it to stop further calls once
# cumulative spend (tracked in eval/results/usage.jsonl) reaches it.
SIMSMITH_PRICE_IN=0.06
SIMSMITH_PRICE_OUT=0.24
SIMSMITH_PRICE_NANO_IN=0.06
SIMSMITH_PRICE_NANO_OUT=0.24
SIMSMITH_PRICE_SUPER_IN=
SIMSMITH_PRICE_SUPER_OUT=
SIMSMITH_PRICE_ULTRA_IN=
SIMSMITH_PRICE_ULTRA_OUT=
SIMSMITH_BUDGET_USD=

# Default max_tokens per call kind; override any one with SIMSMITH_MAX_TOKENS_<KIND>
# (KIND is GENERATE, REPAIR, PLAN, or INTAKE). Defaults: generate/repair=8000, plan/intake=3000.
# Nemotron reasoning models spend a chunk of this on an internal "reasoning" field before
# the actual answer, so don't set these too low -- a trivial "ok" reply has been observed
# to need 40+ completion tokens.

# Tavily web search (simsmith/tavily.py): off by default everywhere. Set SIMSMITH_TAVILY=1
# (plus TAVILY_API_KEY) to opt scripts/baseline_dev.py and scripts/baseline_best_of_5.py
# into the plan-step hook (sanitized real-world failure modes appended to the plan prompt,
# labeled as untrusted reference data) -- see simsmith.tavily.client_from_env(). Never
# enabled for eval/run_eval.py's three official conditions regardless of this setting; only
# a separate, explicitly-requested tavily_on condition would use it there.
TAVILY_API_KEY=
SIMSMITH_TAVILY=
SIMSMITH_TAVILY_MAX_SEARCHES=2
